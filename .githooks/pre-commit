#!/usr/bin/env bash
# Blokuje commit z sekretami lub niedozwolonymi plikami (sprawdza pliki w indeksie).
hooks_dir=$(dirname "$0")
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)
[ ${#files[@]} -eq 0 ] && exit 0
echo "Skanowanie ${#files[@]} plików przed commitem…" >&2
exec bash "$hooks_dir/scan.sh" ":" "${files[@]}"
