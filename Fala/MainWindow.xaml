<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fala.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fala">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="18" Height="18"/>
                <TextBlock Text="Fala" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <SplitView
            x:Name="NowPlayingSplit"
            Grid.Row="1"
            DisplayMode="Overlay"
            PanePlacement="Right"
            OpenPaneLength="420"
            IsPaneOpen="False">
            <SplitView.Pane>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid Padding="20,12,8,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,8,0">
                            <TextBlock Text="{x:Bind L.NowPlaying, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}"
                                    Click="CloseNowPlaying_Click"
                                    ToolTipService.ToolTip="{x:Bind L.Close, Mode=OneWay}">
                                <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            </Button>
                        </Grid>
                        <!-- Całość przewijana: przy niskim oknie notatki nie znikają pod przyciskami -->
                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" Padding="0,0,12,0">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="112" Height="112" VerticalAlignment="Top">
                                        <Border CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border CornerRadius="10">
                                            <Image x:Name="PaneArtwork" Stretch="UniformToFill"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Name="PaneEpisodeTitle" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   FontSize="16" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"/>
                                        <!-- Nazwa podcastu prowadzi do jego odcinków w Bibliotece -->
                                        <HyperlinkButton x:Name="PaneShowLink" Padding="0" Click="PaneGoToShow_Click"
                                                         ToolTipService.ToolTip="{x:Bind L.GoToShow, Mode=OneWay}">
                                            <TextBlock x:Name="PaneShowTitle" Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </Grid>

                                <!-- Akcje z podpisami (CommandBar ukrywa podpisy, dopóki nie zostanie rozwinięty) -->
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PaneActionButtonStyle}" Click="PanePlayNext_Click"
                                            ToolTipService.ToolTip="{x:Bind L.PlayNext, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <FontIcon Glyph="&#xE893;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind L.PlayNextShort, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource PaneActionButtonStyle}" Click="PaneAddToQueue_Click"
                                            ToolTipService.ToolTip="{x:Bind L.AddToQueue, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <FontIcon Glyph="&#xE90B;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind L.AddToQueueShort, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource PaneActionButtonStyle}" Click="PaneAddBookmark_Click"
                                            ToolTipService.ToolTip="{x:Bind L.AddBookmark, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <FontIcon Glyph="&#xE7C1;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind L.AddBookmarkShort, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource PaneActionButtonStyle}" Click="PaneDownload_Click"
                                            ToolTipService.ToolTip="{x:Bind L.DownloadToDisk, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <FontIcon Glyph="&#xE896;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind L.DownloadToDiskShort, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4" Style="{StaticResource PaneActionButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind L.More, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <FontIcon Glyph="&#xE712;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind L.More, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextAlignment="Center"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="{x:Bind L.TogglePlayed, Mode=OneWay}" Click="PaneTogglePlayed_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind L.AddToHistory, Mode=OneWay}" Click="PaneAddToHistory_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind L.DeleteDownload, Mode=OneWay}" Click="PaneDeleteDownload_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="{x:Bind L.GoToShow, Mode=OneWay}" Click="PaneGoToShow_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <TextBlock Text="{x:Bind L.EpisodeNotes, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="PaneSummary" Style="{StaticResource BodyTextBlockStyle}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </SplitView.Pane>

        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="248"
            CompactPaneLength="48"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="0"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind L.NavHome, Mode=OneWay}" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LibraryNavItem" Content="{x:Bind L.NavLibrary, Mode=OneWay}" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind L.NavQueue, Mode=OneWay}" Tag="queue">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90B;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind L.NavHistory, Mode=OneWay}" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind L.NavBookmarks, Mode=OneWay}" Tag="bookmarks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind L.NavSearch, Mode=OneWay}" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{x:Bind L.NavSettings, Mode=OneWay}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Frame x:Name="ContentFrame" Background="Transparent"/>
                <Border
                    x:Name="PlayerBar"
                    Grid.Row="1"
                    Margin="12,0,12,12"
            Padding="16,12"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid ColumnSpacing="12" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ArtworkButton" Padding="0" Width="48" Height="48"
                                CornerRadius="6" BorderThickness="0" Background="Transparent"
                                Click="Artwork_Click">
                            <Grid Width="48" Height="48">
                                <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                                <Border CornerRadius="6">
                                    <Image x:Name="ArtworkImage" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NowPlayingTitle" Text="{x:Bind L.NothingPlaying, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind NowPlayingTitle.Text, Mode=OneWay}"/>
                            <TextBlock x:Name="NowPlayingShow" Text="{x:Bind L.PickEpisode, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="SkipBackButton" Style="{StaticResource IconButtonStyle}"
                                Click="SkipBack_Click" ToolTipService.ToolTip="{x:Bind L.SkipBackTooltip, Mode=OneWay}">
                            <Grid Width="22" Height="22">
                                <FontIcon Glyph="&#xE777;" FontSize="20"/>
                                <TextBlock Text="15" FontSize="8" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButtonStyle}" Click="PlayPause_Click">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16"/>
                        </Button>
                        <ProgressRing x:Name="BufferingRing" Width="16" Height="16" IsActive="False"
                                      Visibility="Collapsed" VerticalAlignment="Center"
                                      ToolTipService.ToolTip="{x:Bind L.Buffering, Mode=OneWay}"/>
                        <Button x:Name="SkipForwardButton" Style="{StaticResource IconButtonStyle}"
                                Click="SkipForward_Click" ToolTipService.ToolTip="{x:Bind L.SkipForwardTooltip, Mode=OneWay}">
                            <Grid Width="22" Height="22">
                                <FontIcon Glyph="&#xE72C;" FontSize="20"/>
                                <TextBlock Text="30" FontSize="8" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="NextQueueButton" Style="{StaticResource IconButtonStyle}"
                                Visibility="Collapsed"
                                Click="NextQueue_Click" ToolTipService.ToolTip="{x:Bind L.NextInQueue, Mode=OneWay}">
                            <FontIcon Glyph="&#xE893;" FontSize="16"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BookmarkButton" Style="{StaticResource IconButtonStyle}"
                                Click="AddBookmark_Click" ToolTipService.ToolTip="{x:Bind L.AddBookmark, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7C1;" FontSize="16"/>
                        </Button>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButtonStyle}"
                                Click="Mute_Click" ToolTipService.ToolTip="{x:Bind L.Volume, Mode=OneWay}">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16"/>
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="1" StepFrequency="0.01"
                                Value="1" VerticalAlignment="Center"
                                IsThumbToolTipEnabled="False"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="SleepStatus" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed"/>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind L.SleepTooltip, Mode=OneWay}">
                            <FontIcon Glyph="&#xE916;" FontSize="16"/>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind L.SleepOff, Mode=OneWay}" Click="SleepOff_Click"/>
                                    <MenuFlyoutItem Text="{x:Bind L.SleepEnd, Mode=OneWay}" Click="SleepEnd_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="{x:Bind L.Sleep5, Mode=OneWay}" Tag="5" Click="SleepMinutes_Click"/>
                                    <MenuFlyoutItem Text="{x:Bind L.Sleep15, Mode=OneWay}" Tag="15" Click="SleepMinutes_Click"/>
                                    <MenuFlyoutItem Text="{x:Bind L.Sleep30, Mode=OneWay}" Tag="30" Click="SleepMinutes_Click"/>
                                    <MenuFlyoutItem Text="{x:Bind L.Sleep45, Mode=OneWay}" Tag="45" Click="SleepMinutes_Click"/>
                                    <MenuFlyoutItem Text="{x:Bind L.Sleep60, Mode=OneWay}" Tag="60" Click="SleepMinutes_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <ComboBox x:Name="SpeedBox" Width="92" MinWidth="92" SelectedIndex="1"
                                  SelectionChanged="SpeedBox_SelectionChanged">
                            <ComboBoxItem Content="0.75×"/>
                            <ComboBoxItem Content="1.0×"/>
                            <ComboBoxItem Content="1.25×"/>
                            <ComboBoxItem Content="1.5×"/>
                            <ComboBoxItem Content="2.0×"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12" MinHeight="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Text="0:00"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" MinWidth="44" HorizontalAlignment="Right"/>
                    <Slider x:Name="ProgressSlider" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="0"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            IsThumbToolTipEnabled="False"
                            StepFrequency="1"
                            Loaded="ProgressSlider_Loaded"
                            ValueChanged="ProgressSlider_ValueChanged"/>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" MinWidth="48"/>
                </Grid>
            </Grid>
        </Border>
            </Grid>
        </NavigationView>
        </SplitView>
    </Grid>
</Window>
