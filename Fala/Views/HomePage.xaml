<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fala.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fala.ViewModels"
    xmlns:m="using:Fala.Models"
    xmlns:h="using:Fala.Helpers"
    x:Name="Root"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Bind L.HomeTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,8,0,0">
                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
                <Button Command="{x:Bind ViewModel.RefreshAllCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="{x:Bind L.RefreshFeeds, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,0" MaxWidth="640"
                HorizontalAlignment="Left"
                Visibility="{x:Bind h:Vis.IfNot(ViewModel.HasShows), Mode=OneWay}">
            <StackPanel Spacing="12">
                <FontIcon Glyph="&#xE8D6;" FontSize="28" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="{x:Bind L.WelcomeTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="{x:Bind L.WelcomeBody, Mode=OneWay}"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="{x:Bind L.RssPlaceholder, Mode=OneWay}"
                             Text="{x:Bind ViewModel.FeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="Feed_KeyDown"/>
                    <Button Grid.Column="1" Content="{x:Bind L.Subscribe, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SubscribeFeedCommand}"
                            Style="{StaticResource AccentButtonStyle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{x:Bind L.ContinueListening, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}"
                   Visibility="{x:Bind h:Vis.If(ViewModel.HasContinue), Mode=OneWay}"/>

        <ListView Grid.Row="3" Height="148"
                  Visibility="{x:Bind h:Vis.If(ViewModel.HasContinue), Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.ContinueItems, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="Continue_ItemClick"
                  SelectionMode="None"
                  Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinWidth" Value="300"/>
                    <Setter Property="MaxWidth" Value="340"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HomeItem">
                    <Border Tag="{x:Bind}" Style="{StaticResource CardStyle}" Padding="12">
                        <Border.ContextFlyout>
                            <MenuFlyout Opening="HomeItemMenu_Opening"/>
                        </Border.ContextFlyout>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="64" Height="64">
                                <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="8">
                                    <Image Stretch="UniformToFill" Source="{x:Bind h:Artwork.FromUrl(Podcast.ArtworkUrl)}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <!-- Stała wysokość dwóch linii: wszystkie karty mają tę samą wysokość -->
                                <TextBlock Text="{x:Bind Episode.Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Height="40"/>
                                <TextBlock Text="{x:Bind Podcast.Title}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Episode.ProgressPercent}" Height="3"/>
                                <TextBlock Text="{x:Bind ProgressText}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4" Text="{x:Bind L.YourPodcasts, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}"
                   Visibility="{x:Bind h:Vis.If(ViewModel.HasShows), Mode=OneWay}"/>

        <GridView Grid.Row="5" Height="196"
                  Visibility="{x:Bind h:Vis.If(ViewModel.HasShows), Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.Shows, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="Show_ItemClick"
                  SelectionMode="None"
                  Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.VerticalScrollMode="Disabled">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="1"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="m:Podcast">
                    <StackPanel Width="128" Margin="0,0,8,0">
                        <Grid Width="128" Height="128">
                            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE8D6;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="8">
                                <Image Stretch="UniformToFill" Source="{x:Bind h:Artwork.FromUrlLarge(ArtworkUrl)}"/>
                            </Border>
                            <InfoBadge HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                       Value="{x:Bind NewCount, Mode=OneWay}"
                                       Visibility="{x:Bind h:Vis.If(HasNew), Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Text="{x:Bind Title}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Grid Grid.Row="6" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind L.NewEpisodes, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}"/>
            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.RecentItems, Mode=OneWay}"
                      IsItemClickEnabled="True"
                      ItemClick="Recent_ItemClick"
                      SelectionMode="None"
                      Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource QuietListViewItemStyle}"/>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeItem">
                        <Grid Tag="{x:Bind}" ColumnSpacing="12">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="HomeItemMenu_Opening"/>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="48" Height="48">
                                <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="6">
                                    <Image Stretch="UniformToFill" Source="{x:Bind h:Artwork.FromUrl(Podcast.ArtworkUrl)}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Episode.Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" Opacity="{x:Bind Episode.TitleOpacity}"/>
                                <TextBlock Text="{x:Bind Podcast.Title}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{x:Bind Episode.ProgressPercent}"
                                             Height="3" Margin="0,4,0,0"
                                             Visibility="{x:Bind h:Vis.If(Episode.ShowProgress)}"/>
                                <TextBlock Text="{x:Bind Episode.MetaText}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" IsHitTestVisible="False">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
