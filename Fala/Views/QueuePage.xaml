<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fala.Views.QueuePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Fala.Models"
    xmlns:h="using:Fala.Helpers"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Bind L.QueueTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}"/>
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent"
                        OverflowButtonVisibility="Collapsed">
                <AppBarButton Label="{x:Bind L.PlayFromQueue, Mode=OneWay}"
                              Command="{x:Bind ViewModel.PlayNextCommand}"
                              IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE893;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Icon="Clear" Label="{x:Bind L.ClearQueue, Mode=OneWay}"
                              Command="{x:Bind ViewModel.ClearCommand}"
                              IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"/>
            </CommandBar>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                Visibility="{x:Bind h:Vis.If(ViewModel.HasNowPlaying), Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="56" Height="56">
                    <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="8">
                        <Image Stretch="UniformToFill" Source="{x:Bind h:Artwork.FromUrl(ViewModel.NowArtwork), Mode=OneWay}"/>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind L.NowPlaying, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.NowTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind ViewModel.NowShow, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{x:Bind L.UpNext, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}"
                   Visibility="{x:Bind h:Vis.If(ViewModel.HasItems), Mode=OneWay}"/>

        <ListView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  CanReorderItems="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource QuietListViewItemStyle}"/>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:QueueItem">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="48" Height="48">
                            <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE8D6;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="6">
                                <Image Stretch="UniformToFill" Source="{x:Bind h:Artwork.FromUrl(ArtworkUrl)}"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Episode.Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ShowTitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ViewModel.PlayItemCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    ToolTipService.ToolTip="{Binding L.Play, ElementName=Root}">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ViewModel.MoveUpCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    ToolTipService.ToolTip="{Binding L.MoveUp, ElementName=Root}">
                                <FontIcon Glyph="&#xE74A;" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ViewModel.MoveDownCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    ToolTipService.ToolTip="{Binding L.MoveDown, ElementName=Root}">
                                <FontIcon Glyph="&#xE74B;" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ViewModel.RemoveItemCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    ToolTipService.ToolTip="{Binding L.RemoveFromQueue, ElementName=Root}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    MaxWidth="420" Margin="0,0,0,48"
                    Visibility="{x:Bind h:Vis.IfNot(ViewModel.HasItems), Mode=OneWay}">
            <FontIcon Glyph="&#xE90B;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="{x:Bind L.QueueEmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="{x:Bind L.QueueEmptyHint, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
