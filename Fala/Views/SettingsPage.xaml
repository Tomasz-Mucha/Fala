<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fala.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Fala.Services"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="4" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind L.SettingsTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16"/>

            <TextBlock Text="{x:Bind L.LanguageLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C1;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind L.LanguageLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind L.LanguageDesc, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="2" Width="180" VerticalAlignment="Center"
                              SelectionChanged="LanguageBox_SelectionChanged">
                        <ComboBoxItem Content="Polski" Tag="pl"/>
                        <ComboBoxItem Content="Svenska" Tag="sv"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="{x:Bind L.Appearance, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8"/>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind L.Theme, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind L.ThemeDesc, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" Width="180" VerticalAlignment="Center"
                              SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem x:Name="ThemeSystemItem" Tag="Default"/>
                        <ComboBoxItem x:Name="ThemeLightItem" Tag="Light"/>
                        <ComboBoxItem x:Name="ThemeDarkItem" Tag="Dark"/>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" FontSize="16" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind L.Accent, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind L.AccentDesc, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <GridView x:Name="AccentGrid" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="AccentGrid_SelectionChanged">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="svc:AccentChoice">
                                <Grid Width="40" Height="40" ToolTipService.ToolTip="{x:Bind Key}">
                                    <Ellipse Width="28" Height="28" Fill="{x:Bind Brush}"
                                             Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1"/>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>

            <TextBlock Text="{x:Bind L.Downloads, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8"/>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE118;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind L.DownloadsFolder, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="DownloadsText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                    <Button x:Name="OpenDownloadsButton" Grid.Column="2" Click="OpenDownloads_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9F9;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                               Text="{x:Bind L.DownloadsHint, Mode=OneWay}"/>
                </Grid>
            </Border>

            <TextBlock Text="{x:Bind L.SubscriptionsSection, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8"/>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE895;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind L.AutoRefreshTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind L.AutoRefreshDesc, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox x:Name="RefreshBox" Grid.Column="2" Width="180" VerticalAlignment="Center"
                              SelectionChanged="RefreshBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Bind L.RefreshOff, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind L.RefreshEvery1, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind L.RefreshEvery3, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind L.RefreshEvery6, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind L.RefreshEvery12, Mode=OneWay}"/>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA8F;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind L.NotificationsTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind L.NotificationsDesc, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="NotificationsSwitch" Grid.Column="2" VerticalAlignment="Center"
                                  OnContent="" OffContent="" MinWidth="0"
                                  Toggled="NotificationsSwitch_Toggled"/>
                </Grid>
            </Border>

            <TextBlock Text="{x:Bind L.Data, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8"/>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind L.AppFolder, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="FolderText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                    <Button x:Name="OpenFolderButton" Grid.Column="2" Click="OpenFolder_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B5;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind L.OpmlTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind L.OpmlDesc, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="OpmlStatus"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="OpmlProgress" Width="20" Height="20" IsActive="False"/>
                        <Button x:Name="ImportOpmlButton" Click="ImportOpml_Click"
                                Content="{x:Bind L.ImportOpml, Mode=OneWay}"/>
                        <Button x:Name="ExportOpmlButton" Click="ExportOpml_Click"
                                Content="{x:Bind L.ExportOpml, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{x:Bind L.About, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8"/>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D6;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Fala" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="AboutText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A5;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind L.ThirdPartyTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind L.ThirdPartyDesc, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Click="OpenNotices_Click" VerticalAlignment="Center"
                            Content="{x:Bind L.Open, Mode=OneWay}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE765;" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind L.ShortcutsTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind L.ShortcutsList, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
