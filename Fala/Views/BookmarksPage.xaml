<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fala.Views.BookmarksPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Fala.Models"
    xmlns:h="using:Fala.Helpers"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Bind L.NavBookmarks, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}"/>
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton Icon="Add" Label="{x:Bind L.AddBookmark, Mode=OneWay}" Click="AddBookmark_Click"/>
                <AppBarButton Icon="Save" Label="{x:Bind L.ExportBookmarks, Mode=OneWay}" Click="ExportBookmarks_Click"/>
            </CommandBar>
        </Grid>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="Bookmark_ItemClick"
                  SelectionMode="None"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource QuietListViewItemStyle}"/>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:Bookmark">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="56" Height="56">
                            <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE8A4;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="8">
                                <Image Stretch="UniformToFill" Source="{x:Bind h:Artwork.FromUrl(ArtworkUrl)}"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ShowTitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind PositionText}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind Comment}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxLines="2"
                                       Visibility="{x:Bind h:Vis.If(HasComment)}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="EditBookmark_Click"
                                    ToolTipService.ToolTip=" ">
                                <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="RemoveBookmark_Click">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    MaxWidth="420" Margin="0,0,0,48"
                    Visibility="{x:Bind h:Vis.IfNot(ViewModel.HasItems), Mode=OneWay}">
            <FontIcon Glyph="&#xE7C1;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="{x:Bind L.BookmarksEmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="{x:Bind L.BookmarksEmptyHint, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
