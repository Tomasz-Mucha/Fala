<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fala.Views.HistoryPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Fala.Models"
    xmlns:h="using:Fala.Helpers"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Bind L.HistoryTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}"/>
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton Icon="Add" Label="{x:Bind L.AddFromLibrary, Mode=OneWay}" Click="AddFromLibrary_Click"/>
                <AppBarButton Label="{x:Bind L.AddCustom, Mode=OneWay}" Click="AddCustom_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE70B;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Icon="Clear" Label="{x:Bind L.ClearHistory, Mode=OneWay}"
                              Command="{x:Bind ViewModel.ClearCommand}"/>
            </CommandBar>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
            <AutoSuggestBox QueryIcon="Find"
                            PlaceholderText="{x:Bind L.HistorySearchPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                            QuerySubmitted="Search_QuerySubmitted"
                            SuggestionChosen="Search_SuggestionChosen"/>
            <TextBlock Text="{x:Bind L.HistorySearchHint, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="History_ItemClick"
                  SelectionMode="None"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource QuietListViewItemStyle}"/>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:HistoryItem">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="48" Height="48">
                            <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE81C;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="6">
                                <Image Stretch="UniformToFill" Source="{x:Bind h:Artwork.FromUrl(ArtworkUrl)}"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind EpisodeTitle}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ShowTitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind WhenText}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                Tag="{x:Bind}" Click="RemoveHistory_Click"
                                ToolTipService.ToolTip=" ">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
