<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fala.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Fala.Models"
    xmlns:h="using:Fala.Helpers"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{x:Bind L.SearchTitle, Mode=OneWay}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="{x:Bind L.SearchSubtitle, Mode=OneWay}"/>
        </StackPanel>

        <!-- Pole wyszukiwania rośnie z oknem do 640 px (wcześniej kurczyło się do szerokości podpowiedzi) -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="640"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox"
                     PlaceholderText="{x:Bind L.SearchPlaceholder, Mode=OneWay}"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="Query_KeyDown"/>
            <Button Grid.Column="1"
                    Content="{x:Bind ViewModel.PrimaryActionLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.GoCommand}"
                    Style="{StaticResource AccentButtonStyle}"/>
            <ProgressRing Grid.Column="2" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.ShowTilesCommand}"
                        ToolTipService.ToolTip="{x:Bind L.ViewTiles, Mode=OneWay}">
                    <Grid>
                        <FontIcon Glyph="&#xE80A;" FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  Visibility="{x:Bind h:Vis.If(ViewModel.IsTiles), Mode=OneWay}"/>
                        <FontIcon Glyph="&#xE80A;" FontSize="16"
                                  Visibility="{x:Bind h:Vis.IfNot(ViewModel.IsTiles), Mode=OneWay}"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.ShowListCommand}"
                        ToolTipService.ToolTip="{x:Bind L.ViewList, Mode=OneWay}">
                    <Grid>
                        <FontIcon Glyph="&#xE8FD;" FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  Visibility="{x:Bind h:Vis.If(ViewModel.IsList), Mode=OneWay}"/>
                        <FontIcon Glyph="&#xE8FD;" FontSize="16"
                                  Visibility="{x:Bind h:Vis.IfNot(ViewModel.IsList), Mode=OneWay}"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <GridView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  Visibility="{x:Bind h:Vis.If(ViewModel.IsTiles), Mode=OneWay}">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,16"/>
                    <Setter Property="Padding" Value="6"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="m:CatalogShow">
                    <StackPanel Width="160">
                        <Grid Width="160" Height="160">
                            <Border CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <FontIcon Glyph="&#xE8D6;" FontSize="36"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="10">
                                <Image Stretch="UniformToFill" Source="{x:Bind h:Artwork.FromUrlLarge(ArtworkUrl)}"/>
                            </Border>
                        </Grid>
                        <TextBlock Margin="2,8,2,0" Text="{x:Bind Title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="2,2,2,4" Text="{x:Bind Author}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Content="{x:Bind ActionLabel, Mode=OneWay}"
                                Click="Subscribe_Click"
                                Tag="{x:Bind}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                  SelectionMode="None" Background="Transparent"
                  Visibility="{x:Bind h:Vis.If(ViewModel.IsList), Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource QuietListViewItemStyle}"/>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:CatalogShow">
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="64" Height="64">
                                <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="8">
                                    <Image Stretch="UniformToFill" Source="{x:Bind h:Artwork.FromUrl(ArtworkUrl)}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Author}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="{x:Bind ActionLabel, Mode=OneWay}"
                                    Click="Subscribe_Click"
                                    Tag="{x:Bind}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
